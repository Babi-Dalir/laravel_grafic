{
    "port": 80,
    "platform": "laravel",
    "app": "amazing-jennings-gic1pmrib",
    "build": {
        "location": "iran"
    },
    "cron": [
        "* * * * * cd $ROOT && php artisan schedule:run >> /dev/null 2>&1"
    ],
    "laravel": {
        "phpVersion": "8.2"
    },
    "disks": [
        {
            "name": "storage",
            "mountTo": "/var/www/html/storage"
        }
    ]
}
